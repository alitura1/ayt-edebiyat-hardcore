{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "public",
  "trailingSlash": false,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.(json|html|js|css|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}
